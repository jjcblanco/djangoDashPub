# CONFIGURACIÓN DE VARIABLES DE ENTORNO
# Copia este archivo a .env y rellena con tus valores

# ======================================
# DJANGO SETTINGS
# ======================================
SECRET_KEY=tu_secret_key_super_seguro_aqui_12345678901234567890
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,tu-dominio.com

# ======================================
# BASE DE DATOS MySQL
# ======================================
DB_ENGINE=django.db.backends.mysql
DB_NAME=trading_db
DB_USER=trading_user
DB_PASSWORD=CAMBIA_ESTA_PASSWORD
DB_HOST=localhost
DB_PORT=3306

# ======================================
# REDIS (separado por base de datos: 0=broker, 1=caché, 2=channels)
# ======================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CACHE_URL=redis://localhost:6379/1
CHANNEL_LAYER_URL=redis://localhost:6379/2

# ======================================
# BINANCE (trading)
# ======================================
BINANCE_APIKEY=tu_api_key_aqui
BINANCE_SECRET=tu_api_secret_aqui

# ======================================
# GOOGLE OAUTH 2.0
# ======================================
GOOGLE_CLIENT_ID=tu_client_id_aqui.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_client_secret_aqui

# ======================================
# EMAIL (OPCIONAL - para recuperación de contraseña)
# ======================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu_email@gmail.com
EMAIL_HOST_PASSWORD=tu_app_password

# ======================================
# SEGURIDAD (PRODUCCIÓN)
# ======================================
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ⚠️ NO poner credenciales reales aquí: este archivo está en el repo público.
# Las credenciales viven en el .env real (ignorado por git).