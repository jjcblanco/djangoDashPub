[Unit]
Description=Celery Beat para Criptodash
After=network.target

[Service]
Type=simple
# Mismo usuario que daphne (web5) para no pelear permisos de logs/celerybeat
User=web5
Group=client2
WorkingDirectory=/var/www/clients/client2/web5/web/criptodash

ExecStart=/var/www/clients/client2/web5/web/venv/bin/celery -A criptodash beat -l info

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
